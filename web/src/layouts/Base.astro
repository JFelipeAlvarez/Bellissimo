---
/**
 * Estructura común de las páginas: <head>, fuentes, íconos y estilos.
 */
import "../styles/global.css";

interface Props {
  titulo: string;
  descripcion: string;
}

const { titulo, descripcion } = Astro.props;
// BASE_URL es "/bellissimo/" en GitHub Pages (ver astro.config.mjs).
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const canonica = new URL(base, Astro.site);
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#F7F1E6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A1311" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <!-- Vista previa cuando se comparte el enlace por WhatsApp o redes. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={new URL(`${base}apple-touch-icon.png`, Astro.site)} />
    <meta property="og:locale" content="es_CO" />

    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&family=Work+Sans:wght@400;500;600&display=swap"
    />

    <!--
      Se ejecuta antes de pintar la página: si el enlace termina en #mesa
      (el QR de las mesas), se ocultan los botones de pedido. Va aquí, y no
      en el script principal, para que no "parpadeen" al cargar.
    -->
    <script is:inline>
      document.documentElement.classList.add(
        /^#mesa\b/i.test(location.hash) ? "mode-mesa" : "mode-delivery",
      );
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
