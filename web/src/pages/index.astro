---
// Página temporal de la fase 0. En la fase 1 se reemplaza por la carta,
// generada a partir de los datos que exporta core/.
const titulo = "Bellissimo";
const lema = "Pastas para sorprender";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
  </head>
  <body>
    <main>
      <h1>{titulo}</h1>
      <p>{lema}</p>
      <p>Nuestra carta digital está en construcción.</p>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100svh;
    display: grid;
    place-items: center;
    background: #f7f1e6;
    color: #2a1f1b;
    font-family: Georgia, "Times New Roman", serif;
    text-align: center;
  }
  h1 {
    margin: 0;
    color: #6b1e2a;
    font-style: italic;
    font-size: 3rem;
  }
</style>
