---
/**
 * La carta. Todo el HTML se genera aquí, en el build, a partir de
 * data/menu.yaml (vía carta.json). El celular del cliente recibe la carta
 * ya escrita: carga rápido y se puede leer aunque el JavaScript falle.
 * El script del final solo agrega lo interactivo.
 */
import ArmaTuPasta from "../components/ArmaTuPasta.astro";
import Carrito from "../components/Carrito.astro";
import Encabezado from "../components/Encabezado.astro";
import Pie from "../components/Pie.astro";
import Seccion from "../components/Seccion.astro";
import Base from "../layouts/Base.astro";
import { carta } from "../lib/carta";

const { restaurante, secciones } = carta;
const pestanas = [
  { id: "arma-tu-pasta", texto: "Arma tu pasta" },
  ...secciones.map((s) => ({ id: s.id, texto: s.pestana ?? s.titulo })),
];
---

<Base
  titulo={`${restaurante.nombre} · ${restaurante.lema}`}
  descripcion={`Carta de ${restaurante.nombre}: ${restaurante.descripcion.toLowerCase()}. Arma tu pasta y pide a domicilio por WhatsApp. ${restaurante.direccion}.`}
>
  <Encabezado />

  <nav class="tabs-bar" aria-label="Secciones de la carta">
    <div class="wrap">
      <div class="tabs" id="pestanas">
        {pestanas.map((p) => <a class="tab" href={`#${p.id}`} data-destino={p.id}>{p.texto}</a>)}
      </div>
    </div>
  </nav>

  <main class="wrap" id="carta">
    <ArmaTuPasta />
    {secciones.map((s) => <Seccion seccion={s} />)}
  </main>

  <Pie />
  <Carrito />
</Base>

<script>
  import "../scripts/carta-interactiva";
</script>
